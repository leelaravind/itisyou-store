# ITISYOU Store — Environment Variables Template
# Copy this file to .env and fill in the values before running locally.
# In Manus hosting, all variables marked [auto] are injected automatically.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/itisyou_store   # [auto in Manus]

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-secret-here                    # [auto in Manus]
VITE_APP_ID=your-manus-app-id                                # [auto in Manus]
OAUTH_SERVER_URL=https://api.manus.im                        # [auto in Manus]
VITE_OAUTH_PORTAL_URL=https://manus.im                       # [auto in Manus]

# ─── Owner ────────────────────────────────────────────────────────────────────
OWNER_OPEN_ID=your-manus-open-id                             # [auto in Manus]
OWNER_NAME=Neela Aravind Karlapudi                           # [auto in Manus]

# ─── Manus Built-in APIs ──────────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im                  # [auto in Manus]
BUILT_IN_FORGE_API_KEY=your-forge-api-key                    # [auto in Manus]
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-key          # [auto in Manus]
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im             # [auto in Manus]

# ─── Analytics (optional) ─────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=                                     # [auto in Manus]
VITE_ANALYTICS_WEBSITE_ID=                                   # [auto in Manus]

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=ITISYOU — Digital Products
VITE_APP_LOGO=
